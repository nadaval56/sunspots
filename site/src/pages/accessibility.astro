import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const REPO = "https://github.com/nadaval56/sunspots";
---

<Base
  title="הצהרת נגישות"
  description="הצהרת הנגישות של האתר: מה הונגש לפי ת״י 5568 ברמה AA, תפריט הנגישות המובנה, מגבלות ידועות, ולמי פונים."
  extraStyles={["assets/legal.css"]}
>
  <article class="wrap legal-article">
    <header>
      <h1>הצהרת נגישות</h1>
      <p class="lede">
        האתר נבנה כך שיהיה שמיש לכל אחד, עם מוגבלות ובלעדיה, בלי תוכנה מיוחדת. הדף מפרט מה נעשה בפועל, מה עדיין לא מושלם, ולמי פונים כשמשהו לא
        עובד.
      </p>
    </header>

    <section class="legal-sec" aria-labelledby="a1">
      <h2 id="a1">1. התקן ורמת הנגישות</h2>
      <p>
        חובת ההנגשה של שירותי אינטרנט קבועה בתקנה 35 לתקנות שוויון זכויות לאנשים עם מוגבלות (התאמות נגישות לשירות), התשע"ג-2013. התקנה מפנה לתקן
        הישראלי ת"י 5568, שמבוסס על הנחיות <span class="mono">WCAG 2.0</span>.
      </p>
      <p>
        האתר הונגש לרמה AA, ככל שידוע לנו, למעט המגבלות שבסעיף 5. צבעי הטקסט והרקע של האתר חושבו לפי נוסחת הניגודיות של WCAG, בבהיר ובכהה,
        ולא נאמדו בעין.
      </p>
    </section>

    <section class="legal-sec" aria-labelledby="a2">
      <h2 id="a2">2. תפריט הנגישות</h2>
      <p>
        בכל דף, בפינה התחתונה, יש כפתור עגול עם סמל הנגישות. אפשר לפתוח אותו גם בקיצור <b>Alt+Shift+A</b> מכל מקום בדף, ולסגור אותו ב-<b>Esc</b>.
        כשהתפריט פתוח, Tab מסתובב בתוכו, ובסגירה המיקוד חוזר למקום שממנו נפתח. הבחירות נשמרות במכשיר שלכם בלבד ומוחלות בכל דף (ראו
        <a href={`${base}privacy/`}>מדיניות הפרטיות</a>).
      </p>
      <div class="tbl-scroll" tabindex="0" role="region" aria-label="טבלת הפקדים בתפריט הנגישות">
        <table class="legal-tbl">
          <caption>הפקדים שבתפריט</caption>
          <thead><tr><th scope="col">פקד</th><th scope="col">מה הוא עושה</th></tr></thead>
          <tbody>
            <tr><td>גודל טקסט: קטן, בינוני, גדול</td><td>מגדיל את כל הטקסט באתר עד 125%. הפריסה מתרחבת יחד איתו, גם ברוחב 360px.</td></tr>
            <tr><td>ניגודיות גבוהה</td><td>שחור על לבן, וקווים מלאים.</td></tr>
            <tr><td>ניגודיות הפוכה</td><td>רקע שחור וטקסט בהיר, לרגישות לאור ולקריאה בחושך.</td></tr>
            <tr><td>גווני אפור</td><td>מנטרל את הצבעים של הממשק ושל הגרפים.</td></tr>
            <tr><td>פונט קריא</td><td>גופן מערכת פשוט (Arial) במקום גופן האתר.</td></tr>
            <tr><td>ריווח שורות ואותיות</td><td>לפי קריטריון 1.4.12 של WCAG 2.1. עוזר בדיסלקציה.</td></tr>
            <tr><td>הדגשת קישורים</td><td>קו תחתון עבה והדגשה, כדי שקישור לא יזוהה לפי צבע בלבד.</td></tr>
            <tr><td>הדגשת מיקוד מקלדת</td><td>מסגרת עבה וכפולה סביב האלמנט שבמיקוד.</td></tr>
            <tr><td>סמן עכבר גדול</td><td>סמן מוגדל בניגודיות גבוהה. על תמונת השמש במעבדה נשאר סמן הכוונת, כדי שיהיה ברור איפה בדיוק מסמנים.</td></tr>
            <tr><td>עצירת אנימציות</td><td>מבטל כל מעבר ותנועה בממשק.</td></tr>
          </tbody>
        </table>
      </div>
      <h3>תמונות השמש במצבי התצוגה</h3>
      <p>
        תמונות השמש הן נתונים מדעיים, ולכן מצבי התצוגה לא הופכים ולא צובעים אותן. לוח הצילום הכהה שסביבן נשאר כהה בכל המצבים, והסימונים של כתם א'
        (תכלת) וכתם ב' (ירוק) נשארים בצבעם גם בגווני אפור, כי הצבע הוא מה שמבדיל ביניהם על התמונה. בטבלת המדידות ובכרטיס התוצאות שני הכתמים מופיעים
        גם בשמם.
      </p>
      <h3>למה התפריט נכתב כאן ולא נלקח מתוסף</h3>
      <ul>
        <li>
          פרטיות: תוסף נגישות מסחרי הוא קוד שנטען מאתר אחר ורץ בדף, בסתירה ל<a href={`${base}privacy/`}>מדיניות הפרטיות</a>, שמצהירה שאין כאן
          קוד של צד שלישי.
        </li>
        <li>זמינות: תוסף שנטען מהרשת לא קיים כשהחיבור איטי או חסום.</li>
        <li>
          תפריט אינו מנגיש אתר בעצמו. הוא מוסיף התאמות תצוגה מעל אתר שכבר נגיש. ת"י 5568 דורש נגישות בקוד עצמו, וזה מפורט בסעיף הבא.
        </li>
      </ul>
    </section>

    <section class="legal-sec" aria-labelledby="a3">
      <h2 id="a3">3. מה נעשה באתר עצמו</h2>

      <h3>מבנה ושפה</h3>
      <ul>
        <li>שפה וכיוון מוגדרים בכל דף (<span class="mono">lang="he"</span>, <span class="mono">dir="rtl"</span>).</li>
        <li>HTML סמנטי: כותרת, ניווט ראשי, אזור תוכן ראשי וכותרת תחתונה, כך שקורא מסך יכול לקפוץ בין האזורים.</li>
        <li>כותרת <span class="mono">h1</span> אחת בכל דף, והיררכיית כותרות בלי דילוגים.</li>
        <li>לכל תמונה יש טקסט חלופי. לציורים של גלילאו ולתמונות SDO בעמוד ההיסטוריה יש תיאור של מה שרואים בהם.</li>
        <li>הטבלאות (אזורים פעילים, מדידות המעבדה) הן טבלאות HTML אמיתיות, עם כותרות עמודה וכיתוב.</li>
        <li>מונח מקצועי מוסבר בפעם הראשונה שהוא מופיע.</li>
      </ul>

      <h3>מקלדת</h3>
      <ul>
        <li>קישור "דילוג לתוכן" בתחילת כל דף.</li>
        <li>כל הכפתורים, המתגים, הקישורים ובוררי התאריכים פועלים במקלדת, עם סימון מיקוד ברור.</li>
        <li>
          במעבדה: כשהמיקוד על תמונת השמש או על רצועת הימים, <b>חץ שמאלה</b> עובר ליום הבא ו<b>חץ ימינה</b> ליום הקודם (בעמוד מימין לשמאל), ו-Home
          ו-End עוברים ליום הראשון והאחרון. הכפתור "טען דוגמה" ממלא מסלול שלם, כך שהתוצאות, הגרפים וטבלת המדידות זמינים גם בלי עכבר.
        </li>
        <li>בעמוד הבית: את עיגול כדור הארץ בקנה מידה אפשר להזיז בחיצים אחרי שמגיעים אליו ב-Tab (עם Shift, בצעדים גדולים).</li>
        <li>אזורים שגוללים לרוחב (טבלאות) נגישים ב-Tab.</li>
      </ul>

      <h3>קוראי מסך</h3>
      <ul>
        <li>
          שינויים שקורים בלי שהמיקוד זז מוכרזים באזור <span class="mono">aria-live</span>: סימון כתם במעבדה, החלפת יום, מקור הנתונים, תוצאת מחוון
          שיינר, והגדרות תפריט הנגישות.
        </li>
        <li>כפתורי בחירה מסמנים את מצבם ב-<span class="mono">aria-pressed</span>, ולכל כפתור שאין עליו טקסט יש שם נגיש.</li>
        <li>לגרפים יש תיאור קצר (<span class="mono">aria-label</span>). על המגבלות של זה ראו סעיף 5.</li>
      </ul>

      <h3>ראייה, צבע ותנועה</h3>
      <ul>
        <li>ניגודיות טקסט של 4.5:1 לפחות, בבהיר ובכהה. האתר עובר למצב כהה לפי הגדרת המערכת.</li>
        <li>
          אזהרות מסומנות גם בסמל ובטקסט ולא רק בצבע. בגרף מחזור השמש הקווים נבדלים גם בעובי ובקווקוו. צבעי הגרפים נבחרו כך שיהיו מובחנים גם
          בעיוורון צבעים.
        </li>
        <li>כל מידות הטקסט יחסיות (<span class="mono">rem</span>), ולכן הגדלת טקסט, בדפדפן או בתפריט, משפיעה על כל האתר.</li>
        <li>אין גלילה אופקית ברוחב 360px, גם בטקסט הגדול ביותר.</li>
        <li>
          האתר מכבד את הגדרת "צמצום תנועה" של המערכת (<span class="mono">prefers-reduced-motion</span>). אין תוכן שמהבהב, ואין שום דבר שמתנגן
          מעצמו: סרטון 30 הימים מתחיל רק בלחיצה, הוא בלי קול, ויש לו פקדי עצירה.
        </li>
        <li>אין הגבלת זמן על שום פעולה.</li>
      </ul>
    </section>

    <section class="legal-sec" aria-labelledby="a4">
      <h2 id="a4">4. איך זה נבדק</h2>
      <ul>
        <li>
          בדיקה אוטומטית: סקריפט שמריץ דפדפן אמיתי על כל עמודי האתר ובודק מידות טקסט ב-px, שהטקסט באמת גדל, את כל עשרת הפקדים בתפריט, גלילה
          אופקית ב-320 וב-420 פיקסלים בטקסט רגיל ומוגדל, מבנה (כותרות, טקסט חלופי, שמות נגישים, קישורים שבורים), וניגודיות מול הרקע האפקטיבי, גם במצב
          "ניגודיות הפוכה".
        </li>
        <li>מקלדת: מעבר על כל דף ב-Tab, ב-Shift+Tab, ב-Enter, ברווח, בחיצים וב-Esc, בלי עכבר.</li>
        <li>תצוגה: בדיקה ידנית במצב בהיר ובמצב כהה, ובכל מצבי התפריט.</li>
      </ul>
      <p>
        את הבדיקות עשה צוות האתר. לא נערכה ביקורת נגישות חיצונית על ידי מורשה נגישות, ואנחנו לא מציגים אישור כזה.
      </p>
    </section>

    <section class="legal-sec" aria-labelledby="a5">
      <h2 id="a5">5. מגבלות ידועות</h2>
      <p>אלה הדברים שאנחנו יודעים שאינם מושלמים:</p>
      <ul>
        <li>
          סימון כתם במעבדה דורש עכבר או מגע. אין דרך לסמן נקודה על תמונת השמש במקלדת בלבד. כחלופה, הכפתור "טען דוגמה" ממלא מסלול שנמדד מראש,
          ואז אפשר לעבור על כל התוצאות, הגרפים וטבלת המדידות במקלדת ובקורא מסך.
        </li>
        <li>
          הגרפים חזותיים ביסודם. לכל גרף יש תיאור קצר לקורא מסך, אבל הערכים עצמם מופיעים בטקסט רק בחלק מהמקומות: במעבדה, בטבלת המדידות ובכרטיס
          התוצאות; בגרף מחזור השמש, ברשימת עובדות (השיאים והחודש האחרון) מתחתיו. לגרף קרני X, לגרף ארוך הטווח של 200 שנה ולגרף "מה ראה גלילאו" אין
          טבלת נתונים מלאה. הערכים המדויקים מוצגים בתיבה שצצה במעבר עכבר, ואינה זמינה במקלדת.
        </li>
        <li>
          תמונות השמש מתוארות באופן כללי. תמונה חדשה מגיעה כל שעה ממצפה בחלל, והטקסט החלופי שלה אומר מה היא ומתי צולמה, אבל לא מתאר איפה
          הכתמים. המידע על הכתמים זמין כטקסט בטבלת האזורים הפעילים שליד התמונה. גם הסימונים של האזורים על התמונה עצמה הם חזותיים בלבד, ומופיעים
          בטבלה.
        </li>
        <li>
          בגרפים של המעבדה שני הכתמים נבדלים בצבע בלבד. שם הכתם מופיע בתיבת המידע של כל נקודה, בכרטיס התוצאות ובטבלת המדידות.
        </li>
        <li>
          סרטון 30 הימים הוא וידאו בלי קול ובלי תיאור קולי. הטקסט שמעליו מסביר מה רואים בו.
        </li>
        <li>
          התוויות שבגרף קרני X ובגרפים של המעבדה לא גדלות עם פקד גודל הטקסט. הן חלק משרטוט בקנה מידה קבוע, ומתכווצות ומתרחבות יחד עם הגרף.
          כך גם המספרים של האזורים הפעילים על תמונת השמש.
        </li>
        <li>
          קישורים לאתרים חיצוניים (NASA, ‏NOAA, ‏SILSO, ‏Wikimedia ועוד) מובילים לאתרים שאינם בשליטתנו, ורבים מהם באנגלית.
        </li>
        <li>
          לא נבדקה תאימות לכל צירוף של דפדפן, מערכת הפעלה וקורא מסך. אם מצאתם צירוף שלא עובד, זה בדיוק הדיווח שיעזור לנו לתקן.
        </li>
      </ul>
    </section>

    <section class="legal-sec" aria-labelledby="a6">
      <h2 id="a6">6. רכז/ת נגישות ופניות</h2>
      <p>
        אם נתקלתם בדף, בפקד או בתוכן שאי אפשר להשתמש בו, כתבו. תיאור קצר של מה ניסיתם לעשות, באיזה דף, ובאיזה דפדפן או טכנולוגיה מסייעת, יקצר את
        הדרך לתיקון. כל פנייה נבדקת, וגם אם התיקון לוקח זמן, תקבלו תשובה.
      </p>

      <div class="contact">
        <p><b>רכז הנגישות:</b> נדב אלשיך</p>
        <p><b>דואר אלקטרוני:</b> <a href="mailto:nadaval56@gmail.com" dir="ltr">nadaval56@gmail.com</a></p>
        <p><b>זמן תגובה:</b> עד 14 ימי עסקים</p>
        <p><b>אפשר גם:</b> <a href={`${REPO}/issues`}>דיווח ב-GitHub Issues</a> (פומבי, ודורש חשבון GitHub)</p>
      </div>

      <p>האתר פועל בלי מקום פיזי שפתוח לקהל, ולכן אין הסדרי נגישות של מבנה, של תשתית או של סביבה לפרט כאן. כל השירות ניתן באינטרנט.</p>

      <p>
        אם הפנייה לא נענתה לשביעות רצונכם, אפשר לפנות אל <a href="https://www.gov.il/he/departments/moj_disability_rights"
          >נציבות שוויון זכויות לאנשים עם מוגבלות</a
        > שבמשרד המשפטים.
      </p>
    </section>

