---
import "@fontsource-variable/heebo/index.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";
import { NAV, SITE_NAME, SITE_TAGLINE, CREDIT_SDO, CREDIT_NOAA } from "../config";

interface Props {
  title?: string;
  description?: string;
  /** Extra stylesheets from public/, relative to the base path (e.g. "assets/legal.css"). */
  extraStyles?: string[];
}
const { title, extraStyles = [], description = `${SITE_NAME}: ${SITE_TAGLINE}. תמונת השמש מתעדכנת כל שעה, ומעבדה למדידת סיבוב השמש.` } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const here = Astro.url.pathname.replace(/\/?$/, "/");
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

// Accessibility menu + privacy notice (docs/A11Y_PRIVACY.md). Served as-is from public/assets/.
// Keys carry a "sunspots:" prefix: on GitHub Pages every project site of the same user shares
// one origin, and privacy.js purges by prefix.
const A11Y_KEY = "sunspots:a11y:v1";
const PRIVACY_KEY = "sunspots:privacy:v1";
const privacyConfig = { key: PRIVACY_KEY, appPrefixes: ["sunspots:"], privacyUrl: `${base}privacy/` };
const a11yConfig = { key: A11Y_KEY, privacyUrl: `${base}privacy/`, accessibilityUrl: `${base}accessibility/` };
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {extraStyles.map((href) => <link rel="stylesheet" href={base + href} />)}
    <link rel="stylesheet" href={`${base}assets/a11y.css`} />
    {/* Pre-paint restore of the visitor's display settings. Reads the privacy decision first:
        whoever declined local storage gets nothing read back. */}
    <script is:inline define:vars={{ A11Y_KEY, PRIVACY_KEY }}>
      try {
        var _p = localStorage.getItem(PRIVACY_KEY);
        if (!_p || JSON.parse(_p).local !== false) {
          var _r = document.documentElement, _a = localStorage.getItem(A11Y_KEY);
          if (_a) {
            _a = JSON.parse(_a);
            if (_a.fs) _r.setAttribute('data-fs', _a.fs);
            if (_a.mode) _r.classList.add('a11y-' + _a.mode);
            ['links', 'readable', 'spacing', 'still', 'cursor', 'focus']
              .forEach(function (k) { if (_a[k]) _r.classList.add('a11y-' + k); });
          }
        }
      } catch (e) { /* private mode or blocked storage: the page loads as usual */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={base}>
          <svg class="mark" viewBox="2 4 28 22.5" aria-hidden="true">
            <g class="mark-loops"><path class="loop loop-1" pathLength="1" d="M20.9 24.8 21.0 23.6 20.9 22.4 20.7 21.3 20.2 20.2 19.6 19.3 18.9 18.5 18.0 18.0 17.0 17.6 16.0 17.5 15.0 17.6 14.0 18.0 13.1 18.5 12.4 19.3 11.8 20.2 11.3 21.3 11.1 22.4 11.0 23.6 11.1 24.8" /><path class="loop loop-2" pathLength="1" d="M22.5 24.0 22.9 22.4 23.1 20.7 23.0 19.0 22.7 17.4 22.0 15.9 21.2 14.6 20.1 13.5 18.8 12.7 17.4 12.2 16.0 12.0 14.6 12.2 13.2 12.7 11.9 13.5 10.8 14.6 10.0 15.9 9.3 17.4 9.0 19.0 8.9 20.7 9.1 22.4 9.5 24.0" /><path class="loop loop-3" pathLength="1" d="M24.0 23.7 24.8 21.7 25.4 19.5 25.6 17.3 25.5 15.0 25.0 12.8 24.2 10.8 23.0 9.0 21.5 7.5 19.8 6.4 17.9 5.7 16.0 5.5 14.1 5.7 12.2 6.4 10.5 7.5 9.0 9.0 7.8 10.8 7.0 12.8 6.5 15.0 6.4 17.3 6.6 19.5 7.2 21.7 8.0 23.7" /></g>
            <path class="mark-limb" d="M3 25H29" />
          </svg>
          <span class="brand-text">
            <span class="brand-name">{SITE_NAME}</span>
            <span class="brand-tag">{SITE_TAGLINE}</span>
          </span>
        </a>
        <nav aria-label="ניווט ראשי">
          <ul>
            {
              NAV.map((item) => {
                const href = base + item.href;
                const current = here === href;
                return (
                  <li>
                    <a href={href} aria-current={current ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul class="credits">
          <li>תמונות השמש: <span lang="en" dir="ltr">{CREDIT_SDO}</span></li>
          <li>נתונים: <span lang="en" dir="ltr">{CREDIT_NOAA}</span></li>
          <li><a href={`${base}about/`}>מקורות ורישוי</a></li>
        </ul>
        <p class="legal-links">
          <a href={`${base}privacy/`}>מדיניות פרטיות</a> · <a href={`${base}accessibility/`}>הצהרת נגישות</a>
        </p>
      </div>
    </footer>

    {/* privacy.js always before a11y.js: a11y.js asks PRIVACY whether it may write. */}
    <script is:inline define:vars={{ privacyConfig, a11yConfig }}>
      window.PRIVACY_CONFIG = privacyConfig;
      window.A11Y_CONFIG = a11yConfig;
    </script>
    <script is:inline src={`${base}assets/privacy.js`}></script>
    <script is:inline src={`${base}assets/a11y.js`}></script>
    <script is:inline src={`${base}assets/brand-anim.js`} defer></script>
  </body>
</html>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--text);
    text-decoration: none;
  }
  .brand-text {
    display: grid;
    line-height: 1.15;
  }
  .brand-tag {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .mark {
    width: 44px;
    height: 35px;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark-loops {
    stroke: var(--accent-fill);
    stroke-width: 2;
  }
  .mark-limb {
    stroke: #f39b1e;
    stroke-width: 2;
  }

  /* ── Logo animation (same behaviour as the UFO and geniza sites) ──────────
     Under two seconds: the solar surface spreads out from the middle, the
     three loops rise one after another from their right footpoint and land on
     the left one, and a warm pulse runs along them from the inner to the
     outer. It plays on load and on hover; public/assets/brand-anim.js replays
     it when the logo comes back on screen and 15 seconds after it last
     played. There is no CSS loop.
     Every element's resting style is the final frame, and the animation runs
     from the "before" state (fill-mode backwards). With reduced motion (the
     OS setting or the accessibility menu) every animation is removed, and the
     logo is simply there, whole and still. */
  @keyframes limb-in { from { transform: scaleX(0); } }
  @keyframes limb-in-2 { from { transform: scaleX(0); } }
  @keyframes loop-draw {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
    4% { opacity: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @keyframes loop-draw-2 {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
    4% { opacity: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @keyframes loop-glow { 45% { stroke: #f39b1e; } }
  @keyframes loop-glow-2 { 45% { stroke: #f39b1e; } }

  .mark-limb {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: limb-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s backwards;
  }
  .loop {
    animation:
      loop-draw 0.6s cubic-bezier(0.4, 0, 0.2, 1) backwards,
      loop-glow 0.5s ease-in-out;
  }
  .loop-1 { animation-delay: 0.35s, 1.2s; }
  .loop-2 { animation-delay: 0.5s, 1.32s; }
  .loop-3 { animation-delay: 0.65s, 1.44s; }

  /* Hover plays it again: different keyframe names, because a browser does
     not restart an animation whose name did not change. Real hover only: on a
     phone :hover sticks after a tap. */
  @media (hover: hover) {
    .brand:hover .mark-limb { animation-name: limb-in-2; }
    .brand:hover .loop { animation-name: loop-draw-2, loop-glow-2; }
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.1rem;
  }
  nav a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  main {
    min-height: 60vh;
  }
  .credits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .legal-links {
    margin: 0.75rem 0 0;
  }
  .site-footer {
    margin-top: 4rem;
    padding-block: 1.5rem 5.5rem; /* room for the fixed accessibility button */
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
