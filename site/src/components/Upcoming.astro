---
// Placeholder body for pages that arrive in later milestones (BRIEF §8).
interface Props {
  title: string;
  milestone: string;
}
const { title, milestone } = Astro.props;
---

<article class="wrap upcoming">
  <h1>{title}</h1>
  <slot />
  <p class="note">העמוד הזה בבנייה ({milestone}).</p>
</article>

<style>
  .upcoming {
    max-width: 46rem;
    padding-top: 2rem;
  }
  .note {
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-top: 2rem;
  }
</style>
