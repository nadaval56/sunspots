---
// "עוד אתרים שלי": the owner's other sites, the same strip his other sites carry
// (copied from X-Ray / geniza-explorer, adapted to this site's tokens).
// The list is written twice: the second copy exists only so the slow scroll below loops
// seamlessly. It is hidden from screen readers and the keyboard, and under reduced motion
// (the OS setting or "עצירת אנימציות" in the accessibility menu) it is not shown at all.
// Links only: nothing is loaded from the other sites.
import { SISTER_SITES } from "../config";
const copies = [false, true];
---

<nav class="sister" aria-label="האתרים הנוספים שלי">
  <span class="sister-lbl">עוד אתרים שלי</span>
  <div class="sister-view">
    <div class="sister-track">
      {
        copies.map((clone) => (
          <div class:list={["sister-set", { "sister-clone": clone }]} aria-hidden={clone ? "true" : undefined}>
            {SISTER_SITES.map(([emoji, url, text, tail]) =>
              tail ? (
                <span class="sister-item">
                  <span aria-hidden="true">{emoji}</span>{" "}
                  <a href={url} rel="noopener" tabindex={clone ? -1 : undefined}>{text}</a>
                  {tail}
                </span>
              ) : (
                <a href={url} rel="noopener" tabindex={clone ? -1 : undefined}>
                  <span aria-hidden="true">{emoji}</span> {text}
                </a>
              ),
            )}
          </div>
        ))
      }
    </div>
  </div>
</nav>

<script>
  /* The strip is an ordinary scroll area: swipe it or scroll it with the mouse.
     This only moves it slowly while nobody touches it, and stops:
       - while a finger, the mouse or keyboard focus is on it (WCAG 2.2.2);
       - for a few seconds after the visitor lets go, so it doesn't fight their own
         scrolling (including momentum after the finger lifts);
       - while it is off screen.
     When the scroll reaches the end of one copy it jumps by exactly one copy's width,
     to the same visual point, so the loop is seamless in both directions.
     Reduced motion (OS setting, or html.a11y-still from the accessibility menu): no
     automatic motion, and CSS hides the second copy. */
  const view = document.querySelector<HTMLElement>(".sister-view");
  const sets = view ? view.querySelectorAll<HTMLElement>(".sister-set") : null;
  if (view && sets && sets.length >= 2) {
    const SPEED = 18; // px per second
    const RESUME_MS = 2500; // wait after a touch before moving again
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let holds = 0;
    let resumeAt = 0;
    let visible = true;
    let pos: number | null = null;
    let last = 0;

    const still = () => reduce.matches || document.documentElement.classList.contains("a11y-still");
    // In RTL scrollLeft is 0 at the right edge and negative towards the left (all modern
    // browsers). The motion reveals items on the left, so scrollLeft decreases.
    const setW = () => Math.abs(sets[0].offsetLeft - sets[1].offsetLeft);
    const wrap = (x: number) => {
      const w = setW();
      const max = view.scrollWidth - view.clientWidth;
      if (!w || w >= max) return x;
      if (x > -1) x -= w; // near the right edge: the same point in the second copy
      if (x < -(max - 1)) x += w; // near the left edge: back to the first copy
      return x;
    };
    const hold = () => {
      holds++;
    };
    const release = () => {
      holds = Math.max(0, holds - 1);
      resumeAt = performance.now() + RESUME_MS;
      pos = null;
    };
    const tick = (t: number) => {
      const dt = last ? Math.min(t - last, 100) : 0;
      last = t;
      if (!still() && visible && !holds && t >= resumeAt) {
        if (pos === null) pos = wrap(view.scrollLeft);
        pos = wrap(pos - (SPEED * dt) / 1000);
        view.scrollLeft = pos;
      } else if (!holds && t < resumeAt) {
        // While waiting: keep the loop going even if the visitor scrolled to the end by hand
        const w = wrap(view.scrollLeft);
        if (w !== view.scrollLeft) view.scrollLeft = w;
      }
      requestAnimationFrame(tick);
    };

    view.addEventListener("touchstart", hold, { passive: true });
    view.addEventListener("touchend", release, { passive: true });
    view.addEventListener("touchcancel", release, { passive: true });
    view.addEventListener("mouseenter", hold);
    view.addEventListener("mouseleave", release);
    view.addEventListener("focusin", hold);
    view.addEventListener("focusout", release);
    view.addEventListener(
      "wheel",
      () => {
        resumeAt = performance.now() + RESUME_MS;
        pos = null;
      },
      { passive: true },
    );
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((e) => {
        visible = e[0].isIntersecting;
      }).observe(view);
    }
    requestAnimationFrame(tick);
  }
</script>

<style>
  .sister {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    line-height: 1.6;
  }
  .sister-lbl {
    flex: none;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .sister-view {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 4px; /* room for the focus ring, which the scroll area would clip */
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 1.25rem, #000 calc(100% - 1.25rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 1.25rem, #000 calc(100% - 1.25rem), transparent 100%);
  }
  .sister-view::-webkit-scrollbar {
    display: none;
  }
  .sister-track {
    display: flex;
    width: max-content;
  }
  .sister-set {
    display: flex;
    gap: 0.5rem;
    padding-inline-end: 0.5rem;
  }
  .sister a,
  .sister-item {
    flex: none;
    white-space: nowrap;
    font-size: 0.8rem;
    color: var(--muted); /* 5.3:1 light, 6.5:1 dark, on --surface */
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
  }
  .sister a:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .sister a:focus-visible {
    color: var(--text);
    outline: 2px solid var(--focus);
    outline-offset: -2px; /* inside the chip, so the scroll area cannot clip it */
  }
  .sister-item a {
    border: 0;
    padding: 0;
    border-radius: 0;
    background: none;
    font-size: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sister-item a:focus-visible {
    outline-offset: 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sister-clone {
      display: none;
    }
  }
  :global(html.a11y-still) .sister-clone {
    display: none;
  }
  @media print {
    .sister {
      display: none;
    }
  }
</style>
